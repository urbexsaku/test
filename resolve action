<?php

declare(strict_types=1);

namespace App\UseCases\QaThread;

use App\Enums\CertificationStatus;
use App\Enums\QaThreadStatus;
use App\Enums\UserRole;
use App\Models\QaThread;
use App\Models\User;
use Illuminate\Contracts\Pagination\LengthAwarePaginator;

/**
 * 質問掲示板スレッド一覧をフィルタ付きで取得するユースケース。
 *
 * - admin: 全資格配下の QaThread
 * - coach: 公開中の担当資格(certification.coaches)配下の QaThread のみ
 * - student: 公開中の全資格配下の QaThread
 * フィルタ: keyword(スレッドタイトル、本文、回答本文の部分一致) / certification_id / status(未解決・解決済)
 */
final class IndexAction
{
    public function __invoke(
        User $auth,
        ?string $keyword = null,
        ?string $certificationId = null,
        ?string $status = null,
        int $perPage = 20,
    ): LengthAwarePaginator {
        $query = QaThread::query()
            ->with(['user', 'certification'])
            ->withCount('replies');

        if ($auth->role === UserRole::Student) {
            $query->whereHas(
                'certification',
                fn ($q) => $q->where('status', CertificationStatus::Published->value),
            );
        }

        if ($auth->role === UserRole::Coach) {
            $query->whereHas(
                'certification',
                fn ($q) => $q->where('status', CertificationStatus::Published->value)
                ->whereHas(
                    'coaches',
                    fn ($coachQuery) => $coachQuery->where('users.id', $auth->id),
                ),
            );
        }

        if ($certificationId !== null && $certificationId !== '') {
            $query->forCertification($certificationId);
        }

        $query->byStatus($status);
        $query->keyword($keyword);

        return $query
            ->latest()
            ->paginate($perPage)
            ->withQueryString();
    }
}

<?php

declare(strict_types=1);

namespace App\UseCases\QaThread;

use App\Models\QaThread;

/**
 * 質問掲示板スレッド詳細を取得するユースケース。
 */
final class ShowAction
{
    public function __invoke(QaThread $thread): QaThread
    {
        return $thread->load([
            'replies.user',
            'user',
            'certification',
        ]);
    }
}

<?php

declare(strict_types=1);

namespace App\UseCases\QaThread;

use App\Models\QaThread;
use App\Models\User;
use Illuminate\Support\Facades\DB;

/**
 * 質問掲示板スレッドを新規作成するユースケース。
 */
final class StoreAction
{
    public function __invoke(User $auth, array $validated): QaThread
    {
        return DB::transaction(fn () => QaThread::create([
            'user_id' => $auth->id,
            'certification_id' => $validated['certification_id'],
            'title' => $validated['title'],
            'body' => $validated['body'],
        ]));
    }
}

<?php

declare(strict_types=1);

namespace App\UseCases\QaThread;

use App\Models\QaThread;
use Illuminate\Support\Facades\DB;

/**
 * 質問掲示板スレッドを更新するユースケース。`certification_id` は不可変で、`title` / `body` のみ更新する。
 */
final class UpdateAction
{
    public function __invoke(QaThread $thread, array $validated): QaThread
    {
        return DB::transaction(function () use ($thread, $validated) {
            $thread->update([
                'title' => $validated['title'],
                'body' => $validated['body'] ?? null,
            ]);

            return $thread->fresh();
    });
    }
}

<?php

declare(strict_types=1);

namespace App\UseCases\QaThread;

use App\Models\QaThread;
use Illuminate\Support\Facades\DB;

/**
 * 質問掲示板スレッドを削除するユースケース。回答がある場合は、先に回答を削除してからスレッドを削除する。
 */
final class DestroyAction
{
    public function __invoke(QaThread $thread): void
    {
        DB::transaction(function () use ($thread) {
            $thread->replies()->delete();
            $thread->delete();
        });
    }
}

<?php

declare(strict_types=1);

namespace App\UseCases\QaThread;

use App\Enums\QaThreadStatus;
use App\Exceptions\QaThread\QaThreadStatusTransitionException;
use App\Models\QaThread;
use Illuminate\Support\Facades\DB;

/**
 * 質問スレッドを解決済みにするユースケース
 */
final class ResolveAction
{
    public function __invoke(QaThread $thread): QaThread
    {
        if ($thread->status !== QaThreadStatus::Open) {
            throw QaThreadStatusTransitionException::forResolve();
        }

        return DB::transaction(function () use ($thread) {
            $thread->update([
                'status' => QaThreadStatus::Resolved->value,
                'resolved_at' => now(),
            ]);

            return $thread->fresh(['user', 'certification']);
        });
    }
}

<?php

declare(strict_types=1);

namespace App\UseCases\QaThread;

use App\Enums\QaThreadStatus;
use App\Exceptions\QaThread\QaThreadStatusTransitionException;
use App\Models\QaThread;
use Illuminate\Support\Facades\DB;

/**
 * 質問スレッドを未解決に戻すユースケース
 */
final class UnresolveAction
{
    public function __invoke(QaThread $thread): QaThread
    {
        if ($thread->status !== QaThreadStatus::Resolved) {
            throw QaThreadStatusTransitionException::forUnresolve();
        }

        return DB::transaction(function () use ($thread) {
            $thread->update([
                'status' => QaThreadStatus::Open->value,
                'resolved_at' => null,
            ]);

            return $thread->fresh(['user', 'certification']);
        });
    }
}


