	Plan/UpdateRequest	duration_days	必須、整数、1～3650	required, integer, min:1, max:3650	受講期間																				
	Plan/UpdateRequest	default_meeting_quota	必須、整数、0～1000	required, integer, min:0, max:1000	面談回数																				
